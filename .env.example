# Environment Configuration Template
# Copy this to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_APP=run.py
SECRET_KEY=your-super-secret-key-here-change-this-immediately

# Database Configuration
# PostgreSQL example: postgresql://user:password@localhost/disease_db
# MySQL example: mysql+pymysql://user:password@localhost/disease_db
# SQLite example: sqlite:///site.db
DATABASE_URL=postgresql://user:password@localhost/disease_db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# File Upload
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760

# Security
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# Email (optional, for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Redis (optional, for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Sentry (optional, for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# Feature Flags
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_DOCTOR_DASHBOARD=true
ENABLE_USER_REGISTRATION=true
